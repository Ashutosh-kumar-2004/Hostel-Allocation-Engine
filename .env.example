# Django Environment & Mode Switch
# Set to 'development' to use local SQLite (db.sqlite3)
# Set to 'production' (or any other value) to connect to Turso / libSQL
ENVIRONMENT=development
DJANGO_SETTINGS_MODULE=config.settings
SECRET_KEY=django-insecure-change-me-in-production-1234567890abcdef
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,https://*.onrender.com

# Turso / libSQL Database (Required when ENVIRONMENT != development)
# e.g., libsql://your-database-name-organization.turso.io or https://...
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Institution Context
DEFAULT_INSTITUTION_ID=inst_demo_university_001

# Cache & Celery Redis Broker (Optional in development)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Email / Notifications (Console for dev)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Object Storage (AWS S3 / MinIO)
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=hostel-allocations
AWS_S3_REGION_NAME=ap-south-1
